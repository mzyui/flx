"┌ help 1-22/47 ────────────────────────────────────────────────────────────────┐"
"│  both screens                                                                │"
"│    q         leave the run and the UI                                        │"
"│    ?         open this key table                                             │"
"│    esc       close the drill-down, then leave                                │"
"│    ↑/k       move up one row                                                 │"
"│    ↓/j       move down one row                                               │"
"│    pgup      move up one page                                                │"
"│    pgdn      move down one page                                              │"
"│    gg/{n}G   top of the list, or row n                                       │"
"│    G         bottom of the list                                              │"
"│    1-9       digits, then G: go to that row                                  │"
"│    s         cycle the sort key                                              │"
"│    /         filter rows (smart-case)                                        │"
"│    e         export the visible rows                                         │"
"│    d         open or close the drill-down                                    │"
"│    enter     open the drill-down                                             │"
"│    S         reverse the sort order                                          │"
"│    x         clear the filter                                                │"
"│                                                                              │"
"│  while running                                                               │"
"│    p         pause or resume probing                                         │"
"│    c         cancel the run, after asking                                    │"
"└──────────────────────────────────────────────────────────────────────────────┘"
