# Generated by Cargo
# will have compiled files and executables
debug/
target/
target/criterion/

# flx is an executable (has [[bin]]), so Cargo.lock is tracked on purpose.

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

dev/

# Local agent instructions, never committed
AGENTS.md

# Graphify knowledge graph output, never committed
graphify-out/

# Editor & agent working directories
.claude/
.opencode

.flx.toml
